ANTHROPIC_API_KEY=your_key_here
DATABASE_URL=sqlite+aiosqlite:///./articles.db

# Tavily search API key — used by the Friday digest agent to search the web.
# Get a free key at https://tavily.com (2000 searches/month free).
TAVILY_API_KEY=your_tavily_key_here

# Comma-separated topics that bias the digest framing and article scoring.
# The agent uses these to find themes and guide web searches.
# Default used if not set:
# INTERESTS=agentic systems, AI/ML, LLM engineering, software architecture
INTERESTS=

# Comma-separated list of allowed frontend origins.
# Development default (localhost) is used if this is not set.
# Production example: CORS_ORIGINS=https://queue.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# API key required on mutating requests (POST /articles, DELETE, chat).
# If not set, auth is skipped — convenient for local dev.
# In production, set this to a long random string and set VITE_API_KEY
# to the same value in frontend/.env.local
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
