ANTHROPIC_API_KEY=your_key_here
DATABASE_URL=sqlite+aiosqlite:///./articles.db

# Comma-separated list of allowed frontend origins.
# Development default (localhost) is used if this is not set.
# Production example: CORS_ORIGINS=https://queue.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# API key required on mutating requests (POST /articles, DELETE, chat).
# If not set, auth is skipped — convenient for local dev.
# In production, set this to a long random string and set VITE_API_KEY
# to the same value in frontend/.env.local
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
